# ==============================================================================
# VAYRO — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# IMPORTANT: Never commit .env.local or expose production secrets to the repository.
# Client-accessible variables MUST be prefixed with NEXT_PUBLIC_.
# Service-role and API secrets MUST NEVER be prefixed with NEXT_PUBLIC_.

# --- Supabase (PostgreSQL, Realtime, Auth, Storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- LiveKit (Real-time Audio & WebRTC) ---
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=

# --- MapLibre / Vector Map Tiles ---
NEXT_PUBLIC_MAP_STYLE_URL=
